<view class="activity-admin-card">
  <view class="activity-admin-card__cover-wrap">
    <image wx:if="{{activity.bannerUrl}}" class="activity-admin-card__cover" mode="aspectFit" src="{{activity.bannerUrl}}" />
    <view wx:else class="activity-admin-card__cover activity-admin-card__cover--placeholder"></view>
  </view>
  <view class="activity-admin-card__content">
    <view class="activity-admin-card__time">{{displayTime}}</view>
    <view class="activity-admin-card__title">{{activity.title}}</view>
    <view class="activity-admin-card__description">{{activity.detailLabel || activity.description}}</view>
    <view class="activity-admin-card__meta">
      <t-tag wx:if="{{activity.isBanner}}" theme="primary" variant="light">轮播</t-tag>
      <t-tag wx:if="{{displayEndTime}}" theme="success" variant="light">{{displayEndTime}}</t-tag>
    </view>
    <view wx:if="{{activity.routeUrl}}" class="activity-admin-card__route">{{activity.routeUrl}}</view>
    <view class="activity-admin-card__actions">
      <t-button variant="outline" theme="default" size="small" bind:tap="onPreviewTap">预览</t-button>
      <t-button theme="primary" size="small" bind:tap="onEditTap">编辑</t-button>
      <t-button theme="danger" variant="outline" size="small" loading="{{loading}}" bind:tap="onDeleteTap">
        删除
      </t-button>
    </view>
  </view>
</view>
