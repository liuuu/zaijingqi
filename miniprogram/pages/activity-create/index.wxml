<view class="page">
  <view class="card">
    <view class="title">新建活动</view>
    <view class="description">填写活动基础信息，保存后会自动生成详情页路由。</view>

    <view class="switch-row">
      <view>
        <view class="field-label field-label--compact">显示为轮播</view>
        <view class="field-help">开启后会显示在活动页顶部轮播图中。</view>
      </view>
      <t-switch value="{{isBanner}}" bind:change="onBannerChange" />
    </view>

    <t-divider content="轮播内容" />

    <t-input
      label="轮播标题"
      value="{{bannerTitle}}"
      placeholder="轮播标题"
      data-field="bannerTitle"
      bind:change="onFieldInput"
    />

    <t-input
      label="标题"
      value="{{title}}"
      placeholder="活动标题"
      data-field="title"
      bind:change="onFieldInput"
    />

    <t-textarea
      label="描述"
      value="{{description}}"
      placeholder="活动描述"
      data-field="description"
      bind:change="onFieldInput"
      autosize="{{true}}"
      maxlength="-1"
    />

    <t-textarea
      label="结论"
      value="{{conclusion}}"
      placeholder="活动结论"
      data-field="conclusion"
      bind:change="onFieldInput"
      autosize="{{true}}"
      maxlength="-1"
    />

    <t-divider content="时间安排" />

    <t-input
      label="开始时间"
      value="{{startTime}}"
      placeholder="2026-05-20 09:00"
      data-field="startTime"
      bind:change="onFieldInput"
    />

    <t-input
      label="结束时间"
      value="{{endTime}}"
      placeholder="2026-05-20 12:00"
      data-field="endTime"
      bind:change="onFieldInput"
    />

    <t-divider content="图片" />


    <view class="wrapper">
      <t-upload
        mediaType="{{['image']}}"
        files="{{images}}"
        gridConfig="{{gridConfig}}"
        config="{{config}}"
        source="messageFile"
        bind:success="handleUploadSuccess"
        bind:remove="handleUploadRemove"
      >
      </t-upload>
    </view>
  </view>
</view>
