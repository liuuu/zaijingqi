page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.banner-section {
  margin-bottom: 24rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.banner-card {
  position: relative;
  height: 420rpx;
  border-radius: 24rpx;
  overflow: hidden;
  /* background: #e9eef8; */
}

.banner-image {
  display: block;
  width: 100%;
  height: 100%;
}

.banner-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
  color: #ffffff;
}

.banner-overlay__title {
  font-size: 38rpx;
  font-weight: 700;
}

.banner-overlay__subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  opacity: 0.92;
}

.description {
  margin-top: 0;
  font-size: 28rpx;
  line-height: 1.7;
  color: #666666;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.conclusion {
  font-size: 28rpx;
  line-height: 1.7;
  color: #444444;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.detail-image {
  display: block;
  width: 100%;
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.empty-text {
  font-size: 26rpx;
  color: #999999;
}
