page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.hero-section {
  margin-bottom: 24rpx;
}

.hero-swiper {
  border-radius: 24rpx;
  overflow: hidden;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111111;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2f6bff;
}

.description {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #666666;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.conclusion {
  font-size: 28rpx;
  line-height: 1.7;
  color: #444444;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.detail-image {
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
}
