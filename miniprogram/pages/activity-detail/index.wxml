<view wx:if="{{activity}}" class="page">
  <view class="hero-section">
    <t-swiper
      class="hero-swiper"
      list="{{swiperList}}"
      height="420rpx"
      autoplay="{{true}}"
      duration="{{500}}"
      interval="{{4000}}"
      navigation="{{true}}"
      imageProps="{{imageProps}}"
    />
  </view>

  <view class="card">
    <view class="title">{{activity.bannerTitle}}</view>
    <view class="subtitle">{{activity.title}}</view>
    <view class="description">{{activity.description}}</view>
    <view class="tag-row">
      <t-tag wx:if="{{activity.isBanner}}" theme="primary" variant="light">轮播活动</t-tag>
      <t-tag wx:if="{{activity.startTime}}" theme="warning" variant="light">开始 {{activity.startTime}}</t-tag>
      <t-tag wx:if="{{activity.endTime}}" theme="success" variant="light">结束 {{activity.endTime}}</t-tag>
    </view>
  </view>

  <view class="card">
    <t-cell title="开始时间" note="{{activity.startTime || '未设置'}}" />
    <t-cell title="结束时间" note="{{activity.endTime || '未设置'}}" />
    <t-divider content="结论" />
    <view class="conclusion">{{activity.conclusion || '暂无结论。'}}</view>
  </view>

    <view class="card">
      <view class="section-title">图片</view>
      <view class="image-grid">
        <t-image
          wx:for="{{activity.images}}"
        wx:key="*this"
        class="detail-image"
        src="{{item}}"
        mode="aspectFill"
      />
    </view>
  </view>
</view>
