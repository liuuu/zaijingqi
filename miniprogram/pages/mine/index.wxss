page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 16rpx;
}

.description {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666666;
}

.password-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #999999;
}

.password-input {
  margin-top: 24rpx;
}

.primary-button,
.secondary-button,
.ghost-button {
  margin-top: 24rpx;
}

.status-card {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #ebedf0;
}

.status-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111111;
}

.status-card__description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.status-card__actions {
  display: flex;
  flex-direction: column;
}

.status-card__actions button + button {
  margin-top: 16rpx;
}
