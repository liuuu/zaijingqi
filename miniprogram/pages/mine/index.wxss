page {
  background: #f6f6f6;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 32rpx;
  box-sizing: border-box;
}

.top-bar {
  position: relative;
  height: 88rpx;
  margin-bottom: 12rpx;
}

.top-bar__title {
  text-align: center;
  line-height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.top-bar__actions {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  gap: 16rpx;
}

.top-bar__action {
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111111;
  font-size: 36rpx;
  line-height: 1;
}

.profile-card,
.stats-card,
.menu-card {
  background: #ffffff;
  border-radius: 32rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.04);
}

.profile-card {
  padding: 48rpx 32rpx 40rpx;
  text-align: center;
}

.avatar-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #eb743c;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar__image {
  width: 100%;
  height: 100%;
}

.avatar__placeholder {
  font-size: 100rpx;
}

.avatar-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border: 0;
  padding: 0;
  margin: 0;
  background: transparent;
}

.avatar-button::after {
  border: 0;
}

.avatar__badge {
  position: absolute;
  right: -8rpx;
  bottom: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.58);
  color: #ffffff;
  font-size: 22rpx;
}

.nickname {
  margin-top: 32rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #111111;
}

.motto {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #a0a0a0;
}

.stats-card {
  margin-top: 24rpx;
  padding: 36rpx 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-item__value {
  font-size: 48rpx;
  font-weight: 700;
  color: #111111;
}

.stat-item__label {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #9b9b9b;
}

.menu-card {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-item {
  min-height: 128rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-item__icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.menu-item__icon--beige { background: #f8efd7; }
.menu-item__icon--blue { background: #e4f1fb; }
.menu-item__icon--purple { background: #eee7fb; }
.menu-item__icon--green { background: #eef7dd; }
.menu-item__icon--gray { background: #efefef; }
.menu-item__icon--orange { background: #f7edd1; }

.menu-item__content {
  flex: 1;
  min-width: 0;
}

.menu-item__title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111111;
}

.menu-item__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a0a0;
}

.menu-item__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-item__badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4e8;
  color: #eb743c;
  font-size: 22rpx;
}

.menu-item__lock {
  line-height: 0;
}

.menu-item__arrow {
  font-size: 48rpx;
  color: #c2c2c2;
}

.password-input {
  margin-top: 16rpx;
}

.dialog-content {
  padding-top: 8rpx;
}

.dialog-content__description {
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.menu-item__lock t-button {
  padding: 0 16rpx;
}
