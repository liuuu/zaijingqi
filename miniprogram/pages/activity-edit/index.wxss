page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111111;
}

.description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 32rpx 0 12rpx;
}

.field-label {
  margin-top: 24rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.field-label--compact {
  margin: 0;
}

.field-help {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.action-row t-button {
  flex: 1;
}

.image-picker {
  margin-top: 24rpx;
}

.image-picker__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  margin-top: 20rpx;
}

.image-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.image-item__preview {
  height: 220rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.image-item__remove {
  width: 100%;
}
