page {
  background: #f6f6f6;
}

.navigation-page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

.hero {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.04);
}

.hero-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: #f0fff4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-title {
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #111111;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #8a8a8a;
}

.venue-card,
.tip-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.04);
}

.venue-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.venue-head__content {
  min-width: 0;
}

.venue-name {
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #111111;
}

.venue-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #18a058;
}

.share-pill {
  flex-shrink: 0;
  margin: 0;
  padding: 0 28rpx;
  height: 68rpx;
  line-height: 68rpx;
  border-radius: 999rpx;
  background: #f0fff4;
  color: #18a058;
  font-size: 26rpx;
  border: none;
}

.address-block {
  padding: 32rpx 0;
}

.label {
  font-size: 24rpx;
  line-height: 1.4;
  color: #999999;
  margin-bottom: 12rpx;
}

.address {
  font-size: 32rpx;
  line-height: 1.55;
  font-weight: 600;
  color: #111111;
}

.guide {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: #666666;
}

.action-row {
  display: flex;
  gap: 20rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.primary-btn {
  background: #18a058;
  color: #ffffff;
}

.secondary-btn {
  background: #f6f6f6;
  color: #111111;
}

.tip-title {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 600;
  color: #111111;
}

.tip-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}
