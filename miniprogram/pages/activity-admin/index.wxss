page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.hero-card,
.activity-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.hero-card {
  margin-bottom: 24rpx;
}

.hero-card__actions {
  margin-top: 24rpx;
}

.activity-card {
  margin-bottom: 24rpx;
  overflow: hidden;
}

.activity-card__cover {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}

.title,
.activity-card__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #111111;
}

.description,
.activity-card__description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.activity-card__route {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999999;
  word-break: break-all;
}

.activity-card__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.activity-card__actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.activity-card__actions t-button {
  flex: 1;
}

.empty-state {
  padding: 96rpx 32rpx;
  text-align: center;
  color: #666666;
}

.empty-state__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.empty-state__desc {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.footer {
  padding: 28rpx 0 12rpx;
  text-align: center;
}

.footer__text {
  font-size: 24rpx;
  color: #999999;
}
