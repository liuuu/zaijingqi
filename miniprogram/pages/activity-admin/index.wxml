<view class="page">
  <view class="hero-card">
    <view class="title">活动管理</view>
    <view class="description">管理活动页中的轮播活动和详情页内容。</view>
    <view class="hero-card__actions">
      <t-button theme="primary" size="large" block bind:tap="onCreateActivity">新建活动</t-button>
    </view>
  </view>
  <view wx:if="{{loading && !activities.length}}" class="empty-state">
    <view class="empty-state__title">加载中...</view>
  </view>
  <view wx:elif="{{activities.length}}" class="activity-list">
    <activity-admin-card
      wx:for="{{activities}}"
      wx:key="id"
      activity="{{item}}"
      loading="{{deletingActivityId === item.id}}"
      bind:preview="onPreviewActivity"
      bind:edit="onEditActivity"
      bind:delete="onDeleteActivity"
    />
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-state__title">暂无活动</view>
    <view class="empty-state__desc">活动创建后会显示在这里。</view>
  </view>
  <view class="footer">
    <view wx:if="{{loadingMore}}" class="footer__text">加载中...</view>
    <view wx:elif="{{hasMore}}" class="footer__text">继续下拉加载更多</view>
    <view wx:else class="footer__text">没有更多活动了</view>
  </view>
</view>
