<view class="page">
  <view class="hero-card">
    <view class="title">活动管理</view>
    <view class="description">管理活动页中的轮播活动和详情页内容。</view>
    <view class="hero-card__actions">
      <t-button theme="primary" size="large" block bind:tap="onCreateActivity">新建活动</t-button>
    </view>
  </view>
  <view wx:if="{{loading && !activities.length}}" class="empty-state">
    <view class="empty-state__title">加载中...</view>
  </view>
  <view wx:elif="{{activities.length}}" class="activity-list">
    <view wx:for="{{activities}}" wx:key="id" class="activity-card">
      <t-image class="activity-card__cover" src="{{item.bannerUrl}}" mode="aspectFill" />
      <t-cell description="{{item.description}}" note="{{item.startTimeStr || item.startTime}}" />
      <view class="activity-card__meta">
        <t-tag wx:if="{{item.isBanner}}" theme="primary" variant="light">轮播</t-tag>
        <t-tag wx:if="{{item.endTimeStr || item.endTime}}" theme="success" variant="light">{{item.endTimeStr || item.endTime}}</t-tag>
      </view>
      <view class="activity-card__route">{{item.routeUrl}}</view>
      <view class="activity-card__actions">
        <t-button variant="outline" theme="default" data-id="{{item.id}}" bind:tap="onPreviewActivity">
          预览
        </t-button>
        <t-button theme="primary" data-id="{{item.id}}" bind:tap="onEditActivity">编辑</t-button>
        <t-button theme="danger" variant="outline" data-id="{{item.id}}" loading="{{deletingActivityId === item.id}}" bind:tap="onDeleteActivity">
          删除
        </t-button>
      </view>
    </view>
  </view>
  <view wx:elif="{{!loading}}" class="empty-state">
    <view class="empty-state__title">暂无活动</view>
    <view class="empty-state__desc">活动创建后会显示在这里。</view>
  </view>
  <view class="footer">
    <view wx:if="{{loadingMore}}" class="footer__text">加载中...</view>
    <view wx:elif="{{hasMore}}" class="footer__text">继续下拉加载更多</view>
    <view wx:else class="footer__text">没有更多活动了</view>
  </view>
</view>
