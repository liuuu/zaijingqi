page {
  background-color: #f6f6f6;
}

.page {
  padding: 32rpx;
}

.swiper-section {
  margin-bottom: 24rpx;
}

.activities-swiper {
  display: block;
  border-radius: 24rpx;
  overflow: hidden;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #111111;
  margin-bottom: 16rpx;
}

.description {
  font-size: 28rpx;
  line-height: 1.6;
  color: #666666;
}

.banner-meta {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ebedf0;
}

.banner-meta__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111111;
}

.banner-meta__description {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #666666;
}

.banner-meta__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0 24rpx;
}

.activity-list {
  display: flex;
  flex-direction: column;
}

.activity-item {
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.activity-item__note {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}
